# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it.

# Supabase project (client-side; safe to expose, but keep per-environment)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Optional: Lovable connector logo lookup
VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY=

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets are NOT read from this file.
# Set them with `supabase secrets set KEY=value` (or the dashboard):
#   ADZUNA_APP_ID, ADZUNA_APP_KEY, ASSESSMENT_INVITE_APP_URL,
#   ASSESSMENT_INVITE_FROM, CLOUDFLARE_TURN_API_TOKEN,
#   CLOUDFLARE_TURN_TOKEN_ID, CONTEST_ALLOCATOR_SECRET, CRON_SECRET,
#   CRON_SECRET_TOKEN, DEMO_CALENDAR_URL, DEMO_REQUEST_FROM_EMAIL,
#   DEMO_REQUEST_TEAM_EMAIL, FERMION_RAPIDAPI_KEY, GITHUB_TOKEN,
#   LOVABLE_API_KEY, METERED_API_KEY, METERED_APP_NAME,
#   MIRROR_SUPABASE_SERVICE_ROLE_KEY, MIRROR_SUPABASE_URL, RESEND_API_KEY
# ---------------------------------------------------------------------------
