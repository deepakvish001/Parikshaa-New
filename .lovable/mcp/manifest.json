        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "topic": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            },
            "time_taken_min": {
              "type": "integer",
              "minimum": 0
            },
            "solved_clean": {
