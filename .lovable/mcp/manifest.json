          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "notification_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "description": "If omitted, marks ALL unread as read."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_select",
        "title": "Query any table",
        "description": "SELECT from any public table. RLS scopes results to the signed-in user. Use for reading ANY feature's data (quizzes, goals, folders, journal, contests, achievements, notifications, resume, outreach, blog, jobs, ratings, etc.).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "columns": {
              "type": "string",
              "description": "Comma-separated columns (default '*')."
            },
            "filters": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "description": "Equality filters: { column: value }. RLS scopes results to the signed-in user."
            },
            "order_by": {
              "type": "string",
              "description": "Column name to order by."
            },
            "ascending": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "required": [
            "table"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_insert",
        "title": "Insert into any table",
        "description": "INSERT rows into any public table. RLS's WITH CHECK enforces ownership — if user_id is required, set it to the signed-in user's id (returned by whoami).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "values": {
              "type": "object",
              "additionalProperties": {},
              "description": "Column → value object for the new row."
            }
          },
          "required": [
            "table",
            "values"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_update",
        "title": "Update rows in any table",
        "description": "UPDATE rows in any public table matching the given filters. RLS restricts which rows can be modified.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "filters": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "description": "Equality filters selecting which rows to update. Required to prevent full-table updates."
            },
            "values": {
              "type": "object",
              "additionalProperties": {},
              "description": "Columns → new values."
            }
          },
          "required": [
            "table",
            "filters",
            "values"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_delete",
        "title": "Delete rows from any table",
        "description": "DELETE rows from any public table matching the given filters. RLS restricts which rows can be deleted. Filters are required.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "filters": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "description": "Equality filters selecting which rows to delete. Required."
            }
          },
          "required": [
            "table",
            "filters"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "publish_coding_problem",
        "title": "Publish coding problem (validated)",
        "description": "Validate + publish a coding problem. Enforces required fields, requires ≥2 tests, and handles slug conflicts. If the slug already exists, use if_exists='update' to overwrite (auto-snapshots current version first) or if_exists='error' (default) to abort and prompt the caller.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "problem": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "difficulty": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "hints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cpu_time_limit_sec": {
                  "type": "number"
                },
                "memory_limit_kb": {
                  "type": "integer"
                },
                "mcq": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "is_contest_pool": {
                  "type": "boolean"
                }
              },
              "required": [
                "slug",
                "title",
                "difficulty",
                "description",
                "topics",
                "examples"
              ],
              "additionalProperties": false
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "expected_output": {
                    "type": "string"
                  },
                  "is_sample": {
                    "type": "boolean"
                  },
                  "weight": {
                    "type": "number"
                  }
                },
                "required": [
                  "input",
                  "expected_output"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            },
            "starter_code": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                },
                "required": [
                  "language",
                  "code"
                ],
                "additionalProperties": false
              }
            },
            "if_exists": {
              "type": "string",
              "enum": [
                "error",
                "update"
              ],
              "description": "Default 'error'. 'update' overwrites and snapshots the previous version."
            },
            "version_note": {
              "type": "string",
              "description": "Note stored on the snapshot when overwriting."
            }
          },
          "required": [
            "problem",
            "tests"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_coding_problem_versions",
        "title": "List coding problem versions",
        "description": "List saved version snapshots for a coding problem slug (admin only).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "rollback_coding_problem",
        "title": "Rollback coding problem",
        "description": "Restore a coding problem (and its tests + starter code) from a saved version snapshot. Also snapshots the CURRENT state before rolling back, so a rollback is itself reversible.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "version_number": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "slug",
            "version_number"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
